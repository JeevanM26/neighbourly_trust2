# ============================================================
# Neighborly Trust — Environment Variables
# Copy this file to .env.local and fill in your values
# ============================================================

# ─── Supabase (required for live data) ───────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Fast2SMS (optional — for real OTP SMS to Indian numbers) ──
# Sign up free at https://www.fast2sms.com
# Free plan: 200 SMS on signup, then ₹0.18/SMS
# Without this key, OTP will appear as an on-screen notification (demo mode)
NEXT_PUBLIC_FAST2SMS_API_KEY=your-fast2sms-api-key-here

# ─── Metered Audio Calling (required for WebRTC audio calls) ──────
NEXT_PUBLIC_METERED_DOMAIN=your-metered-domain-here
NEXT_PUBLIC_METERED_API_KEY=your-metered-api-key-here
